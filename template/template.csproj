<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(BuildAsLibrary)' != 'true'">Exe</OutputType>
    <OutputType Condition="'$(BuildAsLibrary)' == 'true'">Library</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <TrimMode>partial</TrimMode>
    <TrimmerRemoveSymbols>false</TrimmerRemoveSymbols>
  </PropertyGroup>

      <!-- Import NDK pressets -->
    <Import Project="BionicNativeAot.targets"/>

  <!-- For library builds -->
  <PropertyGroup Condition="'$(BuildAsLibrary)' == 'true'">
    <LibraryName>libGame</LibraryName>
    <AssemblyName>$(LibraryName)</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <!-- For non-library builds -->
  <PropertyGroup Condition="'$(BuildAsLibrary)' != 'true'">          
    <AssemblyName>Game</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>false</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</IsWindows> 
    <IsOSX Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsOSX> 
    <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
    <OSArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</OSArch>
    <IsWindowsHost>$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsHost>
		<IsLinuxHost>$([MSBuild]::IsOSPlatform('Linux'))</IsLinuxHost>
		<IsOSXHost>$([MSBuild]::IsOSPlatform('OSX'))</IsOSXHost>
    <IsAndroid>$(RuntimeIdentifier.ToLower().StartsWith('android'))</IsAndroid>
		<IsAndroid Condition="'$(IsAndroid)'=='false'">$(RuntimeIdentifier.ToLower().StartsWith('linux-bionic'))</IsAndroid>
    <IsIOS Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('ios'))">true</IsIOS>
    <IsIOS Condition="'$(IsIOS)' == ''">false</IsIOS>
  </PropertyGroup>

  <Target Name="BuildUrhoCooker">
    <Error Condition="! Exists('$(UrhoNetHome)')" Text="Urho.Net is not configured, please run configure.sh (configure.bat on Windows) from the Urho.Net installation folder" /> 
    <XmlPeek XmlInputPath="$(UrhoNetHome)" Query="UrhoNetHome/add[@key='UrhoNetHome']/@value">
        <Output TaskParameter="Result" ItemName="URHONET_HOME_ROOT" />
    </XmlPeek>
    <PropertyGroup>
      <UrhoCookerCSProj>@(URHONET_HOME_ROOT)\tools\UrhoCooker\UrhoCooker.csproj</UrhoCookerCSProj>
      <UrhoCookerOutputDir>@(URHONET_HOME_ROOT)\tools\UrhoCooker\bin\Release\net10.0</UrhoCookerOutputDir>
    </PropertyGroup>
    <Message Text="Building UrhoCooker from $(UrhoCookerCSProj)" Importance="high" />
    <Exec Command="dotnet build -c Release $(UrhoCookerCSProj)" />
    <ItemGroup>
      <UrhoCookerFiles Include="$(UrhoCookerOutputDir)\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\tools\UrhoCooker" Condition="!Exists('$(MSBuildProjectDirectory)\tools\UrhoCooker')" />
    <Copy SourceFiles="@(UrhoCookerFiles)" 
          DestinationFiles="$(MSBuildProjectDirectory)\tools\UrhoCooker\%(RecursiveDir)%(Filename)%(Extension)" 
          SkipUnchangedFiles="true" />
    <Message Text="UrhoCooker files copied successfully to $(MSBuildProjectDirectory)\tools\UrhoCooker" Importance="high" />
  </Target>


    <ItemGroup Condition="'$(IsAndroid)' == 'true'">
    <!-- https://github.com/exelix11/SysDVR/blob/master/Client/Client.csproj -->
    <!-- Android needs a proper soname property or it will refuse to load the library -->
    <LinkerArg Include="-Wl,-soname,$(LibraryName).so,--undefined-version" />
    </ItemGroup>

  <ItemGroup>
      <None Remove="Web\**" />
      <Compile Remove="Web\**" />
      <Content Remove="Web\**" />
      <EmbeddedResource Remove="Web\**" />
      <ApplicationDefinition Remove="Web\**" />
      <Page Remove="Web\**" />
      <Resource Remove="Web\**" />
      <ProjectReference Remove="Web\**" />
      <PackageReference Remove="Web\**" />
      <UpToDateCheckInput Remove="Web\**" />
      <AvailableItemName Remove="Web\**" />
  </ItemGroup>
  <ItemGroup>
      <None Remove="output\**" />
      <Compile Remove="output\**" />
      <Content Remove="output\**" />
      <EmbeddedResource Remove="output\**" />
      <ApplicationDefinition Remove="output\**" />
      <Page Remove="output\**" />
      <Resource Remove="output\**" />
      <ProjectReference Remove="output\**" />
      <PackageReference Remove="output\**" />
      <UpToDateCheckInput Remove="output\**" />
      <AvailableItemName Remove="output\**" />
  </ItemGroup>
  
  <ItemGroup>
    <AssetsSourceFiles Include="Assets/**/*.*" />
  </ItemGroup>
  
  <PropertyGroup>
    <HomeDir>$(UserProfile)</HomeDir>
    <HomeDir Condition="'$(HomeDir)' == ''">$(Home)</HomeDir>
  </PropertyGroup>

  <PropertyGroup>
    <UrhoNetHome>$(HomeDir)/.urhonet_config/UrhoNetHome.config</UrhoNetHome>
  </PropertyGroup>


  <ItemGroup Condition="'$(IsWindows)'=='true' Or '$(IsOSX)'=='true' Or '$(IsLinux)'=='true'">
    <None Remove="Android\**" />
    <None Remove="IOS\**" />
    <None Remove="libs\dotnet\bcl\ios\**" />
    <None Remove="libs\dotnet\bcl\**" />
  </ItemGroup>

  <Target Name="CustomBeforeBuild" BeforeTargets="BeforeBuild" >
    <Error Condition="! Exists('$(UrhoNetHome)')" Text="Urho.Net is not configured , please run configure.sh (configure.bat on Windows) from the Urho.Net installation folder " /> 
    <XmlPeek XmlInputPath="$(UrhoNetHome)" Query="UrhoNetHome/add[@key='UrhoNetHome']/@value">
        <Output TaskParameter="Result" ItemName="URHONET_HOME_ROOT" />
    </XmlPeek>
    <Message Text="URHONET_HOME_ROOT=@(URHONET_HOME_ROOT)" Importance="high" />

    <!-- Set different UrhoDotNet.dll paths based on target platform -->
  <PropertyGroup>
    <UrhoDotNetDLL Condition="'$(IsAndroid)' == 'true'">@(URHONET_HOME_ROOT)\template\libs\dotnet\urho\mobile\android\UrhoDotNet.dll</UrhoDotNetDLL>
    <UrhoDotNetDLL Condition="'$(IsIOS)' == 'true'">@(URHONET_HOME_ROOT)\template\libs\dotnet\urho\mobile\ios\UrhoDotNet.dll</UrhoDotNetDLL>
    <UrhoDotNetDLL Condition="'$(IsAndroid)' != 'true' And '$(IsIOS)' != 'true'">@(URHONET_HOME_ROOT)\template\libs\dotnet\urho\desktop\UrhoDotNet.dll</UrhoDotNetDLL>
  </PropertyGroup>

    <ItemGroup>
      <Reference Include="UrhoDotNet">
        <HintPath>$(UrhoDotNetDLL)</HintPath>
      </Reference>
    </ItemGroup>
    <Copy SourceFiles="$(UrhoDotNetDLL)" DestinationFolder="References" ContinueOnError="true" />
    <PropertyGroup>
    <UrhoDotNetXML>@(URHONET_HOME_ROOT)\template\libs\dotnet\urho\desktop\UrhoDotNet.xml</UrhoDotNetXML>
    </PropertyGroup>  
    <Copy SourceFiles="$(UrhoDotNetXML)" DestinationFolder="References" ContinueOnError="true" />
  </Target>

  <Target Name="CopyCustomContentWindows" AfterTargets="AfterBuild" Condition="'$(IsWindows)'=='true'">
    <PropertyGroup>
      <libUrho3D>@(URHONET_HOME_ROOT)/template/libs/windows/Urho3D.dll</libUrho3D>
    </PropertyGroup>  
    <Error Condition="! Exists('$(libUrho3D)')" Text="Urho3D.dll not found are you sure URHONET_HOME_ROOT is pointing to the right place ?" /> 
    <Copy SourceFiles="@(AssetsSourceFiles)" DestinationFolder="$(OutDir)\%(RecursiveDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="300" />
    <Copy SourceFiles="$(libUrho3D)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCustomContentMacOS" AfterTargets="AfterBuild" Condition="'$(IsOSX)'=='true'">
    <PropertyGroup>
      <libUrho3D>@(URHONET_HOME_ROOT)/template/libs/macos/$(OSArch)/libUrho3D.dylib</libUrho3D>
    </PropertyGroup>
    <Error Condition="! Exists('$(libUrho3D)')" Text="libUrho3D.dylib not found are you sure URHONET_HOME_ROOT is pointing to the right place ?" /> 
    <Copy SourceFiles="@(AssetsSourceFiles)" DestinationFolder="$(OutDir)\%(RecursiveDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="300" />
    <Copy SourceFiles="$(libUrho3D)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  
  <Target Name="CopyCustomContentLinux" AfterTargets="AfterBuild" Condition="'$(IsLinux)'=='true'">
    <PropertyGroup>
      <libUrho3D>@(URHONET_HOME_ROOT)/template/libs/linux/libUrho3D.so</libUrho3D>
    </PropertyGroup>
    <Error Condition="! Exists('$(libUrho3D)')" Text="libUrho3D.so not found are you sure URHONET_HOME_ROOT is pointing to the right place ?" /> 
    <Copy SourceFiles="@(AssetsSourceFiles)" DestinationFolder="$(OutDir)\%(RecursiveDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="300" />
    <Copy SourceFiles="$(libUrho3D)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

<Target Name="CopyCustomContentPublish" AfterTargets="Publish" 
        Condition="'$(RuntimeIdentifier)'=='linux-x64' Or '$(RuntimeIdentifier)'=='win-x64' Or 
                  '$(RuntimeIdentifier)'=='osx-x64' Or '$(RuntimeIdentifier)'=='osx-arm64'">
     <!-- <Message Text="AssetsSourceFiles: @(AssetsSourceFiles)" Importance="high" /> -->
    <PropertyGroup>
      <OutputPath Condition="'$(PublishDir)' != ''">$(PublishDir)</OutputPath>
      <OutputPath Condition="'$(OutputPath)' == ''">$(OutDir)</OutputPath>
      <libUrho3D Condition="'$(RuntimeIdentifier)'=='linux-x64'">@(URHONET_HOME_ROOT)/template/libs/linux/libUrho3D.so</libUrho3D>
      <libUrho3D Condition="'$(RuntimeIdentifier)'=='win-x64'">@(URHONET_HOME_ROOT)/template/libs/windows/Urho3D.dll</libUrho3D>
      <libUrho3D Condition="'$(RuntimeIdentifier)'=='osx-x64'">@(URHONET_HOME_ROOT)/template/libs/macos/X64/libUrho3D.dylib</libUrho3D>
      <libUrho3D Condition="'$(RuntimeIdentifier)'=='osx-arm64'">@(URHONET_HOME_ROOT)/template/libs/macos/Arm64/libUrho3D.dylib</libUrho3D>
    </PropertyGroup>
    <Error Condition="! Exists('$(libUrho3D)')" Text="libUrho3D.dylib not found are you sure URHONET_HOME_ROOT is pointing to the right place ?" /> 
    <!-- <Copy SourceFiles="@(AssetsSourceFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="300" /> -->
    <Copy SourceFiles="$(libUrho3D)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>


  <Target Name="RemoveXmlFiles" AfterTargets="Publish">
    <ItemGroup>
      <XmlFilesToDelete Include="$(PublishDir)**/*.xml" />
    </ItemGroup>
    <Delete Files="@(XmlFilesToDelete)" />
    <Delete Files="$(PublishDir)$(LibraryName).so.dbg" />
  </Target>

  <Target Name = "CustomAfterClean" AfterTargets="AfterClean">
        <Message Text="Urho.Net clean all" Importance="high" />
        <RemoveDir Directories="bin" />
        <RemoveDir Directories="Android" />
        <RemoveDir Directories="IOS" />
        <RemoveDir Directories="libs" />
        <RemoveDir Directories="output" />
        <RemoveDir Directories="obj" />
        <RemoveDir Directories= "Assets/Data/DotNet" />
        <RemoveDir Directories="Web" />
        <RemoveDir Directories="Intermediate" />
  </Target>

  <!-- needed for intellisense -->
  <ItemGroup>
    <Reference Include="UrhoDotNet" >
        <HintPath>References\UrhoDotNet.dll</HintPath>
    </Reference>
  </ItemGroup>


</Project>
