        {
            "label": "ios-deploy-debug",
            "command": "dotnet",
            "type": "process",
            "dependsOn": "build-urho-cooker",
            "args": [
                "${workspaceFolder}/tools/UrhoCooker/UrhoCooker.dll",
                "--task",
                "build",
                "--type",
                "debug",
