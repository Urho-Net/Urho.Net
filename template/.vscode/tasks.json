{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-urho-cooker",
            "command": "dotnet",
            "type": "process",
            "args": [
                "msbuild",
                "-t:BuildUrhoCooker"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "ios-build-release",
            "command": "dotnet",
            "type": "process",
            "dependsOn": "build-urho-cooker",
            "args": [
                "${workspaceFolder}/tools/UrhoCooker/UrhoCooker.dll",
                "--task",
                "build",
                "--type",
                "release",
                "--architecture",
                "ios",
                "--path",
                ".",
                "--developer",
                "${input:DeveloperID}",
                "--graphics",
                "metal",
                "--obfuscate",
                "true"
            ],
            "problemMatcher": []
        },
        {
            "label": "ios-deploy-release",
            "command": "dotnet",
            "type": "process",
            "dependsOn": "build-urho-cooker",
            "args": [
                "${workspaceFolder}/tools/UrhoCooker/UrhoCooker.dll",
                "--task",
                "build",
                "--type",
                "release",
                "--architecture",
                "ios",
                "--path",
                ".",
                "--developer",
                "${input:DeveloperID}",
                "--graphics",
                "metal",
                "--obfuscate",
                "true",
                "--install",
                "true"
            ],
            "problemMatcher": []
        },
        {
            "label": "ios-build-debug",
